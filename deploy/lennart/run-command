#!/bin/sh
set -eu

deployment_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$deployment_dir"

cmd="$1"
shift

if docker compose version >/dev/null 2>&1; then
    exec docker compose run --rm --no-deps \
        virtitta "$cmd" --config /config/virtitta.toml "$@"
fi

exec docker-compose run --rm --no-deps \
    virtitta "$cmd" --config /config/virtitta.toml "$@"
