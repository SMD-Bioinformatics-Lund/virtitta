#!/bin/sh
set -eu

deployment_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$deployment_dir"

if docker compose version >/dev/null 2>&1; then
    exec docker compose run --rm --no-deps \
        virtitta import-run --config /config/virtitta.toml "$@"
fi

exec docker-compose run --rm --no-deps \
    virtitta import-run --config /config/virtitta.toml "$@"
