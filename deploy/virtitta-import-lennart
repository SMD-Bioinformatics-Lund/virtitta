#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
compose_file="$project_dir/compose.lennart.yaml"

if docker compose version >/dev/null 2>&1; then
    exec docker compose --project-directory "$project_dir" --file "$compose_file" \
        run --rm --no-deps virtitta import-run --config /config/virtitta.toml "$@"
fi

exec docker-compose --project-directory "$project_dir" --file "$compose_file" \
    run --rm --no-deps virtitta import-run --config /config/virtitta.toml "$@"
